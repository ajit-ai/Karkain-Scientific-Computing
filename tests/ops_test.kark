func test_r2_transpose() {
    let v = [1, 2, 3, 4]
    let out = []
    let c = 0
    while (c < 2) {
        let r = 0
        while (r < 2) {
            push(out, v[r * 2 + c])
            r = r + 1
        }
        c = c + 1
    }
    assert_eq(len(out), 4)
    assert_eq(out[0], 1)
    assert_eq(out[1], 3)
    assert_eq(out[2], 2)
    assert_eq(out[3], 4)
}

func test_r2_determinant() {
    let a = [1, 2, 3, 4]
    assert_eq(a[0] * a[3] - a[1] * a[2], -2)
    let c = [6,1,1,4,-2,5,2,8,7]
    let d = c[0] * (c[4]*c[8] - c[5]*c[7]) - c[1] * (c[3]*c[8] - c[5]*c[6]) + c[2] * (c[3]*c[7] - c[4]*c[6])
    assert_eq(d, -306)
}

func test_r2_integer_sqrt_and_dot() {
    let n = 625
    let x = n
    let y = (x + 1) / 2
    while (y < x) {
        x = y
        y = (x + n / x) / 2
    }
    assert_eq(x, 25)
    let v = [1,2,3]
    let w = [4,5,6]
    let sum = 0
    let i = 0
    while (i < 3) {
        sum = sum + v[i] * w[i]
        i = i + 1
    }
    assert_eq(sum, 32)
}
